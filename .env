PUBLIC_URL=./
CORS_ORIGINS=*
SHYNTR_INTERNAL_API_URL=http://localhost:7497
SHYNTR_PUBLIC_API_URL=http://localhost:7496

# Optional: comma-separated list of additional trusted origins for external
# password verifier services. Only exact http/https origin matches are accepted
# (scheme + host + port). Wildcards are not supported.
# Example: SHYNTR_AUTH_ALLOWED_ORIGINS=https://auth.example.com,https://verifier.internal:8443
# SHYNTR_AUTH_ALLOWED_ORIGINS=
